# Copy this file to .env and fill in YOUR values. Never commit or share .env.

# Platforms to publish to (comma separated)
PUBLISH_PLATFORMS=instagram,youtube,tiktok
# buffer (recommended) or direct (platform APIs directly, see publisher/instagram.py etc.)
PUBLISH_BACKEND=buffer

# --- Buffer --- (publish.buffer.com > Settings > API)
BUFFER_API_KEY=
# addToQueue: follow each channel's posting schedule in Buffer | customScheduled: at BUFFER_TIME | shareNow: right away
BUFFER_MODE=addToQueue
BUFFER_TIME=19:00
# Scheduled posts Buffer allows per channel (free plan 10, paid plans more -> e.g. 100)
BUFFER_MAX_QUEUE=10
# Channel ids if you have more than one channel of a kind (python -m publisher check lists them)
BUFFER_CHANNEL_TIKTOK=
BUFFER_CHANNEL_INSTAGRAM=
BUFFER_CHANNEL_YOUTUBE=
# Mark posts as "made with AI" on the platforms
BUFFER_AI_LABEL=false
# These platforms are published as notifications (you add sound/music on your phone and post), e.g. tiktok
BUFFER_NOTIFY_PLATFORMS=

# --- Cloudflare R2 (public URLs for the videos; Buffer fetches them from there) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=promo-videos
R2_PUBLIC_BASE_URL=
# Optional folder inside the bucket (default: a slug of app_name from brand.json)
R2_PREFIX=

# --- Speko (voice-over) --- platform.speko.ai/agents/keys
SPEKO_API_KEY=

# --- Only for PUBLISH_BACKEND=direct ---
IG_USER_ID=
IG_ACCESS_TOKEN=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_MODE=inbox
